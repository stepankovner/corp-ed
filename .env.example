ENVIRONMENT=development
DEBUG=false

POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql+asyncpg://corp_ed:CHANGEME@localhost:5432/corp_ed
TEST_DATABASE_URL=postgresql+asyncpg://corp_ed:CHANGEME@localhost:5432/corp_ed_test

# Сгенерировать: openssl rand -hex 32. Короче 32 символов — приложение
# не стартует: слабым ключом токены подделываются офлайн.
SECRET_KEY=

# Токены: access живёт минуты, refresh — дни и ротируется при каждом
# использовании. Дефолты в коде; менять — только осознанно.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14

# Yandex Cloud: консоль → каталог → сервисные аккаунты → API-ключ
YC_FOLDER_ID=b1g00000000000000000
YC_API_KEY=AQVN0000000000000000000

# Модель ответа — решение ML 25.09 (docs/backend-handoff.md, задача 1).
# yandex-openai: /v1/chat/completions; yandex-native: только YandexGPT.
LLM_PROVIDER=yandex-openai
LLM_MODEL=aliceai-llm-flash
# Квота — 10 одновременных запросов на каталог; при N воркерах — 10 / N.
LLM_MAX_CONCURRENCY=8
# Квота эмбеддингов — 10 в секунду на каталог, общая для API и воркера.
# Доли: вопросы сотрудников и фоновый ингест (в сумме не больше 10).
# Эмбеддинги — решение ML 25.09: text-embeddings-v2, размерность 768.
# Размерность — свойство схемы (vector(768)): смена = миграция + переиндексация.
EMBEDDING_MODEL=text-embeddings-v2
EMBEDDING_DIM=768
EMBEDDING_QUERY_RPS=3
EMBEDDING_INGEST_RPS=6

# RAG — значения за ML (Артём). Размеры в ТОКЕНАХ (count_tokens = len/3).
RAG_CHUNK_TOKENS=400            # кандидат 600/50 — финал на золотом наборе (A7 E3)
RAG_OVERLAP_TOKENS=50
RAG_FAQ_LIMIT=5                 # top-K; уточнится в E4
RAG_FAQ_MAX_DISTANCE=0.51       # для text-embeddings-v2@768 (BH-18); финал — A8 к 12.10
RAG_CONTEXT_MAX_TOKENS=3000     # бюджет выдержек (досье 8.2); при 600/50 — 3300
RAG_FAQ_TEMPERATURE=0
# Поиск (M1, BH-12): vector — как в замерах задачи 1; hybrid — вектор +
# полнотекст через RRF, включать по замеру ML на золотом наборе.
RAG_RETRIEVER=vector
RAG_FULLTEXT_WEIGHT=0.5

# Пул кредитов компании (досье 10.2): места × кредитов на место в месяц,
# жёсткая остановка при исчерпании (HTTP 402). Числа — предложение досье,
# не утверждены; дефолты в коде. Места задаёт команда: cli set-seats.
# BILLING_CREDITS_PER_SEAT=420
# BILLING_TOKENS_PER_CREDIT=2000
# BILLING_TIMEZONE=Europe/Moscow
# BILLING_WARN_AT_PERCENT=80

# HTTP-периметр. В production ALLOWED_HOSTS и CORS обязательны явно —
# со «*» приложение не стартует. /docs и /openapi.json в production выключены.
# ALLOWED_HOSTS=api.krontoai.ru
# CORS_ALLOWED_ORIGINS=https://krontoai.ru,https://app.krontoai.ru
# MAX_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=26214400

# Redis: счётчики лимитов частоты (и ограничитель квоты эмбеддингов).
# Пусто — счётчики в памяти процесса (только разработка). В production
# обязателен: без него приложение не стартует.
# REDIS_URL=redis://:CHANGEME@localhost:6379/0
