ENVIRONMENT=development
DEBUG=false

# Владелец схемы (миграции) и роль приложения (только данные, без DDL и
# BYPASSRLS) — разные пароли. В compose приложение подключается как
# corp_ed_app, миграции — как corp_ed (см. docs/DEPLOY.md).
POSTGRES_PASSWORD=CHANGEME
APP_DB_PASSWORD=CHANGEME
# Локальный запуск без Docker: одна роль на всё (разработка).
DATABASE_URL=postgresql+asyncpg://corp_ed:CHANGEME@localhost:5432/corp_ed
TEST_DATABASE_URL=postgresql+asyncpg://corp_ed:CHANGEME@localhost:5432/corp_ed_test
# MIGRATIONS_DATABASE_URL=postgresql+asyncpg://corp_ed:CHANGEME@localhost:5432/corp_ed
REDIS_PASSWORD=CHANGEME

# Сгенерировать: openssl rand -hex 32. Короче 32 символов — приложение
# не стартует: слабым ключом токены подделываются офлайн.
SECRET_KEY=

# Токены: access живёт минуты, refresh — дни и ротируется при каждом
# использовании. Дефолты в коде; менять — только осознанно.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# Сессия без «Запомнить это устройство» — не дольше (часы)
# SESSION_REFRESH_TTL_HOURS=12

# Yandex Cloud: консоль → каталог → сервисные аккаунты → API-ключ
YC_FOLDER_ID=b1g00000000000000000
YC_API_KEY=AQVN0000000000000000000

# Модель ответа — решение ML 25.09 (docs/backend-handoff.md, задача 1).
# yandex-openai: /v1/chat/completions; yandex-native: только YandexGPT.
LLM_PROVIDER=yandex-openai
# Разработка фронта без ключей: LLM_PROVIDER=fake (ответ из первой выдержки,
# эмбеддинги «мешок слов»; YC_* не нужны). В production запрещено.
# С «мешком слов» расстояния больше, чем у моделей Яндекса: для fake
# поставьте RAG_FAQ_MAX_DISTANCE=0.8, иначе почти всё уйдёт в общий ответ.
LLM_MODEL=aliceai-llm-flash
# Режим fake печатает ответ по словам с этой паузой (мс) — как поток модели.
# LLM_FAKE_STREAM_DELAY_MS=30
# Квота — 10 одновременных запросов на каталог; при N воркерах — 10 / N.
LLM_MAX_CONCURRENCY=8
# Квота эмбеддингов — 10 в секунду на каталог, общая для API и воркера.
# Доли: вопросы сотрудников и фоновый ингест (в сумме не больше 10).
# Эмбеддинги — решение ML 25.09: text-embeddings-v2, размерность 768.
# Размерность — свойство схемы (vector(768)): смена = миграция + переиндексация.
EMBEDDING_MODEL=text-embeddings-v2
EMBEDDING_DIM=768
EMBEDDING_QUERY_RPS=3
EMBEDDING_INGEST_RPS=6

# RAG — значения за ML (Артём). Размеры в ТОКЕНАХ (count_tokens = len/3).
RAG_CHUNK_TOKENS=400            # 400/50 выбрано на золотом наборе (A7 E3: 600/50 хуже)
RAG_OVERLAP_TOKENS=50
RAG_FAQ_LIMIT=5                 # top-K (E4: k = 8 — шум, +46 % токенов)
RAG_FAQ_MAX_DISTANCE=0.59       # text-embeddings-v2@768; решение 30.09 (ML-4, таблицы; было 0.51), финал — holdout 11–12.10
# BH-37: «отвечать ли» — по ближайшему фрагменту до GATE, выдержки — до MAX;
# ближайший в зоне (MAX; GATE] — выдержки не дальше него + NEAR_MARGIN.
# Пусто — один порог MAX, как раньше. Решение Р-17 (Артём, 04.10, после
# совместного замера ML): включить, 0.70. Выкатка стенда берёт это значение
# в .env сервера сама (deploy/stage/deploy.sh, «настройки ответов»).
RAG_FAQ_GATE_DISTANCE=0.70
RAG_FAQ_NEAR_MARGIN=0.05
RAG_CONTEXT_MAX_TOKENS=3000     # бюджет выдержек (досье 8.2)
RAG_FAQ_TEMPERATURE=0
# Поиск (M1, BH-12): vector — как в замерах задачи 1; hybrid — вектор +
# полнотекст через RRF, включать по замеру ML на золотом наборе.
RAG_RETRIEVER=vector
RAG_FULLTEXT_WEIGHT=0.5
# Память диалога (BH-28): сколько последних пар «вопрос — ответ» учитывать
# в уточняющих вопросах. 3 — замер ML 01.10 (верных уточнений 8 → 15 из
# 19); 0 — выключено (ни переписывания вопроса, ни истории).
RAG_HISTORY_TURNS=3
# Сколько диалог живёт в Redis после последнего вопроса (решение 30.09).
RAG_HISTORY_TTL_MINUTES=720
RAG_CONDENSE_TIMEOUT_SECONDS=5
# Реранкер (M3, BH-32): пусто — выключен. Решение 04.10: включать после
# BH-40. Включить: модель — deploy/reranker/fetch-model.sh, в .env —
# COMPOSE_PROFILES=reranker и имя модели ниже (DEPLOY.md, INTEGRATION.md).
RAG_RERANK_MODEL=
# RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RAG_RERANK_URL=http://reranker:8080
# RAG_RERANK_DEPTH=30
# RAG_RERANK_MAX_LENGTH=512
# RAG_RERANK_TIMEOUT_MS=3000
# BH-40: вопросы длиннее стольких слов — без реранкера, по вектору (на
# длинных «разговорных» он выталкивает нужный фрагмент; замер ML 04.10).
# Пусто — без ограничения.
RAG_RERANK_MAX_WORDS=24

# Отчёт о пробелах (BH-21): python -m corp_ed.cli gaps --all раз в сутки,
# после purge. Значения — ML (задача 3): порог кластеров 0.6 — по
# синтетике, уточнить на живых логах.
GAPS_CLUSTER_DISTANCE=0.6
GAPS_HALF_LIFE_DAYS=14
# Пороги полнотекста (ts_rank_cd) подобрать на живых логах; пока не заданы —
# полнотекст в классификации не участвует. Задавать только парой.
# GAPS_STRONG_FULLTEXT=
# GAPS_EMPTY_FULLTEXT=
# GAPS_OFF_TOPIC_DISTANCE=
# Инженерные ограничения, дефолты в коде:
# GAPS_WINDOW_DAYS=30
# GAPS_MAX_QUESTIONS=2000
# GAPS_MIN_CLUSTER_SIZE=2
# GAPS_MAX_LABELS_PER_RUN=50

# Пул кредитов компании (досье 10.2): места × кредитов на место в месяц,
# жёсткая остановка при исчерпании (HTTP 402). 1 кредит = 4 000 токенов ≈
# одно обращение (BH-30, 29.09); дефолты в коде. Места — cli set-seats.
# BILLING_CREDITS_PER_SEAT=420
# BILLING_TOKENS_PER_CREDIT=4000
# BILLING_TIMEZONE=Europe/Moscow
# BILLING_WARN_AT_PERCENT=80

# Коннекторы к системам клиентов. Ключ шифрования учётных данных
# источников (Fernet); в production обязателен. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Несколько ключей через запятую — ротация: первым шифруем, остальными читаем.
CONNECTOR_SECRETS_KEYS=
# Технический потолок подключений на компанию (не тариф) и бюджет запуска.
# CONNECTOR_MAX_PER_TENANT=20
# CONNECTOR_DEFAULT_SYNC_INTERVAL_MINUTES=60
# CONNECTOR_MAX_DOCUMENTS_PER_RUN=200
# CONNECTOR_MAX_RUN_MINUTES=20
# CONNECTOR_MAX_DOCUMENT_BYTES=26214400
# CONNECTOR_MAX_LARGE_DOCUMENT_BYTES=104857600
# CONNECTOR_SYNC_RUN_RETENTION_DAYS=90
# Процесс за egress-прокси (HTTPS_PROXY): запросы к системам клиентов по
# имени хоста вместо закреплённого IP (прокси отвергает CONNECT к IP);
# проверка адреса остаётся. Только если прокси действительно есть.
# CONNECTOR_OUTBOUND_VIA_PROXY=false
# В production флаг без HTTPS_PROXY в окружении — отказ старта (RISKS №39).
# OAuth-приложения (Битрикс24, режим per_user). callback — публичный адрес
# ручки обратного вызова (его админ вписывает в карточку локального
# приложения на портале, фронт показывает из /connectors/kinds); return —
# страница фронта, куда вернётся браузер сотрудника (без неё — JSON).
# CONNECTOR_OAUTH_CALLBACK_URL=https://api.example.ru/api/v1/connectors/oauth/callback
# CONNECTOR_OAUTH_RETURN_URL=https://app.example.ru/sources
# CONNECTOR_OAUTH_STATE_TTL_MINUTES=10
# CONNECTOR_BITRIX24_OAUTH_SERVER=https://oauth.bitrix24.tech/
# CONNECTOR_YANDEX_OAUTH_SERVER=https://oauth.yandex.ru/
# CONNECTOR_YANDEX_DISK_API=https://cloud-api.yandex.net/
# CONNECTOR_YANDEX_WIKI_API=https://api.wiki.yandex.net/

# Разбор файлов. Форматы Р-5 сверх docx, pdf, txt и md (BH-33…BH-35; приняты ML 01.10).
# Убрать формат из списка — он снова отклоняется с подсказкой и не
# скачивается из подключённых систем; уже загруженные файлы остаются.
INGEST_EXTRA_FORMATS=xlsx,pptx,doc

# Запись на созвон со страницы тарифов (/pricing). Форма собирает имя и
# телефон — мы оператор персональных данных: включать только с опубликованной
# политикой обработки и её версией (без них с LEADS_ENABLED=true старт
# отменяется). Заявки читает команда: `cli leads list`; удаляет `cli purge`.
# LEADS_ENABLED=false
# LEADS_POLICY_URL=https://krontoai.ru/privacy
# LEADS_POLICY_VERSION=2026-10-01
# LEADS_RETENTION_DAYS=180
# LEADS_DAYS_AHEAD=30
# Письмо о каждой заявке с контактами — в ящик команды (через MAIL_BACKEND,
# не в Telegram). Пусто — писем нет, заявки только в `cli leads list`.
# Лендинг krontoai.ru шлёт заявки сюда же: его адрес нужен в
# CORS_ALLOWED_ORIGINS.
# LEADS_NOTIFY_EMAIL=info@krontoai.ru

# Уведомления нашей команде в Telegram: новая заявка на созвон, компания
# исчерпала пул, подключение остановлено ошибкой. Без персональных данных.
# Задаются парой или не задаются вовсе. Нужен исходящий доступ к
# api.telegram.org (DEPLOY.md, §9a).
# TEAM_NOTIFY_TELEGRAM_BOT_TOKEN=
# TEAM_NOTIFY_TELEGRAM_CHAT_ID=

# --- Письма (ТЗ §3) ---------------------------------------------------------
# postbox — Yandex Cloud Postbox по HTTPS (стенд и бой: Selectel закрывает
# исходящие 25, 465, 587 — SMTP оттуда не уходит, RISKS №57); smtp — сервер
# без закрытых портов; console — в лог (разработка); memory — тесты.
# MAIL_BACKEND=console
# Postbox: статический ключ сервисного аккаунта с ролью postbox.sender
# (STAGE.md §4.5а). Секрет — только сюда, не в чат.
# MAIL_POSTBOX_KEY_ID=
# MAIL_POSTBOX_SECRET_KEY=
# SMTP — ящик Яндекс 360 на krontoai.ru: пароль приложения — только сюда.
# MAIL_SMTP_HOST=smtp.yandex.ru
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURITY=ssl
# MAIL_SMTP_USERNAME=noreply@krontoai.ru
# MAIL_SMTP_PASSWORD=
# Отправитель — адрес домена, подтверждённого в Postbox (или логин SMTP).
# MAIL_FROM_ADDRESS=noreply@krontoai.ru
# MAIL_FROM_NAME=kronto
# Адрес сайта для ссылок в письмах
# MAIL_SITE_URL=https://krontoai.ru

# Самостоятельная регистрация. false — только по приглашению (боевой домен,
# пока нет юридических текстов). Версия политики пишется в учётку.
# REGISTRATION_ENABLED=true
# REGISTRATION_POLICY_URL=/privacy
# REGISTRATION_POLICY_VERSION=draft-2026-10-04

# Песочница на сайте (/demo): вопросы без входа к вымышленной компании.
# Компанию заводит `cli demo setup` (его запускает выкатка). Места — пул
# кредитов на месяц, то есть потолок расходов на модель от посетителей.
# DEMO_ENABLED=true
# DEMO_COMPANY_CODE=demo-site
# DEMO_ACCOUNT_EMAIL=demo@krontoai.ru
# DEMO_SEATS=30

# Модули коннекторов, не проверенные на живой системе: скрыты, пока не
# перечислены здесь (через запятую). Сейчас — «База знаний 2.0» Битрикс24.
# CONNECTOR_PREVIEW_MODULES=knowledge_base_v2

# Виды подключений, которые не предлагаются компаниям (через запятую:
# bitrix24, confluence, yandex360): их нет в каталоге, новое не создать;
# уже созданные работают. Тексты сайта (SiteHome, SecurityPage) — правкой.
# CONNECTOR_HIDDEN_KINDS=yandex360

# HTTP-периметр. В production ALLOWED_HOSTS и CORS обязательны явно —
# со «*» приложение не стартует. /docs и /openapi.json в production выключены.
# 127.0.0.1 — для HEALTHCHECK контейнера: проверка идёт через TrustedHost.
# ALLOWED_HOSTS=api.krontoai.ru,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://krontoai.ru,https://app.krontoai.ru
# Адреса reverse proxy, чьим X-Forwarded-For верит uvicorn (--proxy-headers).
# Иначе лимиты частоты и аудит видят адрес прокси или подделанный заголовок.
# В compose.yaml задано там (шлюз закреплённой подсети, 172.30.61.1) и
# значение отсюда перекрывает; здесь — для запуска без Docker.
# FORWARDED_ALLOW_IPS=127.0.0.1
# MAX_BODY_BYTES=1048576
# Файлы: вложения, аватар, логотип и документы xlsx, doc, txt, md — 25 МБ;
# документы pdf, docx и pptx — 100 МБ (nginx: client_max_body_size 101m на
# /api/v1/materials/upload). Больших загрузок одновременно — не больше 2.
# MAX_UPLOAD_BYTES=26214400
# MAX_LARGE_UPLOAD_BYTES=104857600
# MAX_CONCURRENT_LARGE_UPLOADS=2

# Redis: счётчики лимитов частоты (и ограничитель квоты эмбеддингов).
# Пусто — счётчики в памяти процесса (только разработка). В production
# обязателен: без него приложение не стартует.
# REDIS_URL=redis://:CHANGEME@localhost:6379/0
