# Копия дампа вне сервера (offsite.sh, STAGE.md §4.11). Файл на сервере —
# /etc/kronto/offsite.env, владелец root, группа deploy, права 640.
# Значения — только в этот файл: не в чат, не в репозиторий.

# Открытые ключи age держателей через пробел (каждый делает age-keygen на
# своём компьютере). Закрытые ключи — только у держателей: копию
# расшифрует любой из них, без них — никто.
OFFSITE_AGE_RECIPIENT="age1... age1..."

# Куда класть: <имя remote>:<бакет>/<папка>. Remote «offsite» описан
# переменными ниже (rclone читает их из окружения, файла конфига нет).
OFFSITE_REMOTE=offsite:kronto-backups/stage

# Yandex Object Storage — у другого провайдера, чем сервер (Selectel):
# проблема с одним аккаунтом не уносит и сервер, и копии. Статический
# ключ сервисного аккаунта с ролью storage.uploader на этот бакет:
# загрузка без удаления. Срок хранения задаёт правило бакета (30 дней),
# версионирование бакета сохраняет копию и при перезаписи (STAGE.md §4.11).
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://storage.yandexcloud.net
RCLONE_CONFIG_OFFSITE_REGION=ru-central1
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# Только если у хранилища нет правила срока хранения: копии старше N дней
# удаляет сервер (ключу тогда нужно и удаление).
# OFFSITE_KEEP_DAYS=30
